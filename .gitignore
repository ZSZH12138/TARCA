.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
coverage/
node_modules/
playwright-report/
test-results/
*.tsbuildinfo
build/
dist/
*.egg-info/
.idea/
.vscode/
.DS_Store
Thumbs.db

# 正式数据、模型与大体积实验产物不进入 Git。
/data/
checkpoints/
/third_party/stage1b/
/third_party/stage2/
/artifacts/stage2/source-capsules/
/deploy/stage2/wheelhouse/
artifacts/**/runtime/
/artifacts/test-tmp-*/

# Stage1B 默认全部留在本地，只发布活动指针和唯一 v2 的小型冻结证据。
/artifacts/stage1b/**
!/artifacts/stage1b/
!/artifacts/stage1b/active.json
!/artifacts/stage1b/frozen/
/artifacts/stage1b/frozen/**
!/artifacts/stage1b/frozen/v2/
/artifacts/stage1b/frozen/v2/**
!/artifacts/stage1b/frozen/v2/qualification_receipt.json
!/artifacts/stage1b/frozen/v2/manifest.json
!/artifacts/stage1b/frozen/v2/manifest.sha256

# E01 默认结果、数据库、服务器包和回收副本仅保存在本地；Git 只发布 v2 收据和唯一 v1 历史记录。
/artifacts/e01/**
!/artifacts/e01/
!/artifacts/e01/active.json
!/artifacts/e01/frozen/
/artifacts/e01/frozen/**
!/artifacts/e01/frozen/v2/
!/artifacts/e01/frozen/v2/qualification_receipt.json
!/artifacts/e01/history/
/artifacts/e01/history/**
!/artifacts/e01/history/e01_v1_history_record.json

# Stage 0 的小型合同和 Gate artifact 应保留。
!artifacts/stage0/
!artifacts/stage0/*.json
